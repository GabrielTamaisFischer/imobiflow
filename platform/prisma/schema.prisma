  id              String      @id @default(uuid()) @db.Char(36)
  companyId       String      @map("company_id") @db.Char(36)
  websiteId       String      @map("website_id") @db.Char(36)
  versionNumber   Int         @map("version_number")
  label           String?     @db.VarChar(160)
  snapshotJson    Json        @map("snapshot_json")
  createdById     String?     @map("created_by_id") @db.Char(36)
  createdAt       DateTime    @default(now()) @map("created_at")
  website         Website     @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, versionNumber])
  @@index([companyId, websiteId])
  @@map("website_versions")
}

model WebsitePublishLog {
  id              String                @id @default(uuid()) @db.Char(36)
  companyId       String                @map("company_id") @db.Char(36)
  websiteId       String                @map("website_id") @db.Char(36)
  status          WebsitePublishStatus  @default(queued)
  message         String?               @db.Text
  metadataJson    Json                  @map("metadata_json")
  createdById     String?               @map("created_by_id") @db.Char(36)
  createdAt       DateTime              @default(now()) @map("created_at")
  website         Website               @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([companyId, websiteId, status])
  @@map("website_publish_logs")
}

model WebsiteCodeFile {
  id              String        @id @default(uuid()) @db.Char(36)
  companyId       String        @map("company_id") @db.Char(36)
  websiteId       String        @map("website_id") @db.Char(36)
  pageId          String?       @map("page_id") @db.Char(36)
  filePath        String        @map("file_path") @db.VarChar(500)
  fileType        String        @map("file_type") @db.VarChar(80)
  language        String        @db.VarChar(40)
  content         String        @db.LongText
  createdById     String?       @map("created_by_id") @db.Char(36)
  updatedById     String?       @map("updated_by_id") @db.Char(36)
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  website         Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  page            WebsitePage?  @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@unique([companyId, websiteId, filePath])
  @@index([companyId, websiteId, fileType])
  @@index([pageId])
  @@map("website_code_files")
}

model WebsiteAuditLog {
  id              String              @id @default(uuid()) @db.Char(36)
  companyId       String              @map("company_id") @db.Char(36)
  websiteId       String?             @map("website_id") @db.Char(36)
  pageId          String?             @map("page_id") @db.Char(36)
  sectionId       String?             @map("section_id") @db.Char(36)
  componentId     String?             @map("component_id") @db.Char(36)
  assetId         String?             @map("asset_id") @db.Char(36)
  actorUserId     String?             @map("actor_user_id") @db.Char(36)
  action          WebsiteAuditAction
  entityType      String              @map("entity_type") @db.VarChar(80)
  entityId        String?             @map("entity_id") @db.Char(36)
  summary         String?             @db.VarChar(240)
  metadataJson    Json                @map("metadata_json")
  ipAddress       String?             @map("ip_address") @db.VarChar(80)
  userAgent       String?             @map("user_agent") @db.VarChar(300)
  createdAt       DateTime            @default(now()) @map("created_at")
  website         Website?            @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  page            WebsitePage?        @relation(fields: [pageId], references: [id], onDelete: SetNull)
  section         WebsiteSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  component       WebsiteComponent?   @relation(fields: [componentId], references: [id], onDelete: SetNull)
  asset           WebsiteAsset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([companyId, websiteId, createdAt])
  @@index([companyId, action, createdAt])
  @@map("website_audit_logs")
}
