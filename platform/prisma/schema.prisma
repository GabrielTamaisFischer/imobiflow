generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id            String        @id @default(uuid()) @db.Char(36)
  name          String        @db.VarChar(160)
  document      String?       @db.VarChar(40)
  phone         String?       @db.VarChar(40)
  email         String?       @db.VarChar(160)
  status        String        @default("active") @db.VarChar(40)
  isSynthetic   Boolean       @default(false) @map("is_synthetic")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  users         AppUser[]
  roles         Role[]
  invitations   UserInvitation[]
  authSessions  AuthSession[]
  passwordResetTokens PasswordResetToken[]
  authAuditLogs AuthAuditLog[]
  subscriptions Subscription[]
  accountProvisionings AccountProvisioning[]
  owners        PropertyOwner[]
  properties    Property[]
  companySites  CompanySite[]
  leads         Lead[]
  crmPipelines  CrmPipeline[]
  crmStages     CrmStage[]
  leadEvents    LeadEvent[]
  siteLeads     SiteLead[]
  crmRoutingConfig CrmRoutingConfig?
  crmRoutingMembers CrmRoutingMember[]
  leadActivities LeadActivity[]
  appointments  Appointment[]
  importJobs    ImportJob[]
  importRows    ImportRow[]

  @@index([status])
  @@map("companies")
}

model AppUser {
  id            String        @id @default(uuid()) @db.Char(36)
  companyId     String        @map("company_id") @db.Char(36)
  roleId        String        @map("role_id") @db.Char(36)
  name          String        @db.VarChar(160)
  email         String        @unique(map: "users_email_key") @db.VarChar(180)
  phone         String?       @db.VarChar(40)
  passwordHash  String?       @map("password_hash") @db.VarChar(180)
  status        String        @default("active") @db.VarChar(40)
  isSynthetic   Boolean       @default(false) @map("is_synthetic")
  role          String        @default("owner") @db.VarChar(60)
  permissionsJson Json        @map("permissions_json")
  passwordChangedAt DateTime? @map("password_changed_at")
  lastLoginAt   DateTime?     @map("last_login_at")
  failedLoginAttempts Int     @default(0) @map("failed_login_attempts")
  lockedUntil   DateTime?     @map("locked_until")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleRecord    Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  authSessions  AuthSession[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent UserInvitation[] @relation("InvitationSender")
  authAuditLogs AuthAuditLog[] @relation("AuthAuditActor")
  activatedProvisionings AccountProvisioning[] @relation("ProvisioningOwner")
  routingMemberships CrmRoutingMember[]
  assignedLeads Lead[] @relation("LeadAssignee")
  leadActivities LeadActivity[]
  routingLastAssigned CrmRoutingConfig[] @relation("RoutingLastAssigned")
  leadEvents LeadEvent[]
  responsibleForProperties Property[] @relation("PropertyResponsibleUser")

  @@unique([companyId, email])
  @@index([companyId, status])
  @@map("users")
}

model Permission {
  id          String           @id @default(uuid()) @db.Char(36)
  key         String           @unique @db.VarChar(120)
  description String           @db.VarChar(240)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id          String           @id @default(uuid()) @db.Char(36)
  companyId   String           @map("company_id") @db.Char(36)
  name        String           @db.VarChar(100)
  systemKey   String?          @map("system_key") @db.VarChar(60)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       AppUser[]
  invitations UserInvitation[]

  @@unique([companyId, name])
  @@unique([companyId, systemKey])
  @@index([companyId, isSystem])
  @@map("roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Char(36)
  permissionId String     @map("permission_id") @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserInvitation {
  id          String    @id @default(uuid()) @db.Char(36)
  companyId   String    @map("company_id") @db.Char(36)
  roleId      String    @map("role_id") @db.Char(36)
  invitedById String?   @map("invited_by") @db.Char(36)
  email       String    @db.VarChar(180)
  name        String?   @db.VarChar(160)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  status      String    @default("pending") @db.VarChar(40)
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy   AppUser?  @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
  @@index([email, status])
  @@map("user_invitations")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Char(36)
  companyId        String    @map("company_id") @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  accessTokenJti   String    @unique @map("access_token_jti") @db.Char(36)
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  ipAddress        String?   @map("ip_address") @db.VarChar(80)
  userAgent        String?   @map("user_agent") @db.VarChar(300)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  companyId String    @map("company_id") @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuthAuditLog {
  id           String   @id @default(uuid()) @db.Char(36)
  companyId    String   @map("company_id") @db.Char(36)
  actorUserId  String?  @map("actor_user_id") @db.Char(36)
  action       String   @db.VarChar(120)
  entityType   String   @map("entity_type") @db.VarChar(80)
  entityId     String?  @map("entity_id") @db.Char(36)
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor        AppUser? @relation("AuthAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@map("auth_audit_logs")
}

model Subscription {
  id                     String    @id @default(uuid()) @db.Char(36)
  companyId              String    @map("company_id") @db.Char(36)
  planId                 String?   @map("plan_id") @db.Char(36)
  status                 String    @default("PENDING") @db.VarChar(40)
  planSlug               String?   @map("plan_slug") @db.VarChar(80)
  billingProvider        String?   @map("billing_provider") @db.VarChar(60)
  externalSubscriptionId String?   @map("external_subscription_id") @db.VarChar(180)
  currentPeriodStart     DateTime? @map("current_period_start")
  currentPeriodEnd       DateTime? @map("current_period_end")
  graceEndsAt            DateTime? @map("grace_ends_at")
  expiresAt              DateTime? @map("expires_at")
  cancelledAt            DateTime? @map("cancelled_at")
  isSynthetic            Boolean   @default(false) @map("is_synthetic")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan                   Plan?     @relation(fields: [planId], references: [id], onDelete: Restrict)
  activationProvisioning AccountProvisioning?

  @@index([companyId, status])
  @@index([planId, status])
  @@unique([billingProvider, externalSubscriptionId])
  @@map("subscriptions")
}

model Plan {
  id              String   @id @default(uuid()) @db.Char(36)
  slug            String   @unique @db.VarChar(80)
  name            String   @db.VarChar(120)
  description     String?  @db.VarChar(500)
  billingInterval String   @default("monthly") @map("billing_interval") @db.VarChar(40)
  priceCents      Int      @map("price_cents")
  currency        String   @default("BRL") @db.Char(3)
  featuresJson    Json?    @map("features_json")
  active          Boolean  @default(true)
  isSynthetic     Boolean  @default(false) @map("is_synthetic")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  subscriptions   Subscription[]
  checkoutSessions CheckoutSession[]
  accountProvisionings AccountProvisioning[]

  @@index([active, isSynthetic, priceCents])
  @@map("plans")
}

model CheckoutSession {
  id                String    @id @default(uuid()) @db.Char(36)
  planId            String    @map("plan_id") @db.Char(36)
  provider          String    @db.VarChar(60)
  externalSessionId String?   @map("external_session_id") @db.VarChar(180)
  externalSubscriptionId String? @map("external_subscription_id") @db.VarChar(180)
  purchaserEmail    String    @map("purchaser_email") @db.VarChar(180)
  status            String    @default("PENDING") @db.VarChar(40)
  amountCents       Int       @map("amount_cents")
  currency          String    @default("BRL") @db.Char(3)
  checkoutUrl       String?   @map("checkout_url") @db.VarChar(1200)
  expiresAt         DateTime? @map("expires_at")
  confirmedAt       DateTime? @map("confirmed_at")
  isSynthetic       Boolean   @default(false) @map("is_synthetic")
  metadataJson      Json?     @map("metadata_json")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  plan              Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentEvents     PaymentEvent[]
  provisioning      AccountProvisioning?

  @@unique([provider, externalSessionId])
  @@index([purchaserEmail, status, createdAt])
  @@index([planId, status])
  @@map("checkout_sessions")
}

model PaymentEvent {
  id                String   @id @default(uuid()) @db.Char(36)
  checkoutSessionId String   @map("checkout_session_id") @db.Char(36)
  provider          String   @db.VarChar(60)
  externalEventId   String   @map("external_event_id") @db.VarChar(180)
  eventType         String   @map("event_type") @db.VarChar(100)
  status            String   @db.VarChar(40)
  amountCents       Int?     @map("amount_cents")
  currency          String?  @db.Char(3)
  payloadHash       String   @map("payload_hash") @db.Char(64)
  occurredAt        DateTime @map("occurred_at")
  processedAt       DateTime? @map("processed_at")
  isSynthetic       Boolean  @default(false) @map("is_synthetic")
  metadataJson      Json?    @map("metadata_json")
  createdAt         DateTime @default(now()) @map("created_at")
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@index([checkoutSessionId, status])
  @@map("payment_events")
}

model AccountProvisioning {
  id                String    @id @default(uuid()) @db.Char(36)
  checkoutSessionId String    @unique @map("checkout_session_id") @db.Char(36)
  planId            String    @map("plan_id") @db.Char(36)
  purchaserEmail    String    @map("purchaser_email") @db.VarChar(180)
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  status            String    @default("READY") @db.VarChar(40)
  expiresAt         DateTime  @map("expires_at")
  activatedAt       DateTime? @map("activated_at")
  companyId         String?   @unique @map("company_id") @db.Char(36)
  ownerUserId       String?   @unique @map("owner_user_id") @db.Char(36)
  subscriptionId    String?   @unique @map("subscription_id") @db.Char(36)
  isSynthetic       Boolean   @default(false) @map("is_synthetic")
  metadataJson      Json?     @map("metadata_json")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  plan              Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner             AppUser?  @relation("ProvisioningOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([purchaserEmail, status, expiresAt])
  @@map("account_provisionings")
}

model PropertyOwner {
  id                  String       @id @default(uuid()) @db.Char(36)
  companyId           String       @map("company_id") @db.Char(36)
  createdBy           String?      @map("created_by") @db.Char(36)
  ownerType           String       @default("individual") @map("owner_type") @db.VarChar(40)
  clientType          String       @default("proprietario") @map("client_type") @db.VarChar(40)
  name                String       @db.VarChar(180)
  document            String?      @db.VarChar(40)
  email               String?      @db.VarChar(180)
  phone               String?      @db.VarChar(40)
  whatsapp            String?      @db.VarChar(40)
  residentialPhone    String?      @map("residential_phone") @db.VarChar(40)
  commercialPhone     String?      @map("commercial_phone") @db.VarChar(40)
  addressJson         Json         @map("address_json")
  notes               String?      @db.Text
  status              String       @default("active") @db.VarChar(40)
  portalToken         String?      @map("portal_token") @db.VarChar(120)
  portalEnabled       Boolean      @default(false) @map("portal_enabled")
  portalLastAccessAt  DateTime?    @map("portal_last_access_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  company             Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties          Property[]

  @@index([companyId, status])
  @@index([companyId, document])
  @@map("property_owners")
}

model Property {
  id                      String          @id @default(uuid()) @db.Char(36)
  companyId               String          @map("company_id") @db.Char(36)
  ownerId                 String?         @map("owner_id") @db.Char(36)
  createdBy               String?         @map("created_by") @db.Char(36)
  code                    String?         @db.VarChar(40)
  title                   String          @db.VarChar(220)
  description             String?         @db.Text
  propertyType            String          @default("apartment") @map("property_type") @db.VarChar(40)
  operation               String          @default("sale") @db.VarChar(40)
  status                  String          @default("draft") @db.VarChar(40)
  street                  String?         @db.VarChar(180)
  number                  String?         @db.VarChar(40)
  complement              String?         @db.VarChar(120)
  neighborhood            String?         @db.VarChar(120)
  city                    String?         @db.VarChar(120)
  state                   String?         @db.VarChar(40)
  zipCode                 String?         @map("zip_code") @db.VarChar(20)
  country                 String?         @db.VarChar(80)
  latitude                Float?
  longitude               Float?
  condominiumName         String?         @map("condominium_name") @db.VarChar(160)
  nearbyHighways          Json            @map("nearby_highways")
  responsibleUserId       String?         @map("responsible_user_id") @db.Char(36)
  captureJson             Json            @map("capture_json")
  primaryDetailsJson      Json            @map("primary_details_json")
  measurementsJson        Json            @map("measurements_json")
  salePriceCents          Int?            @map("sale_price_cents")
  rentPriceCents          Int?            @map("rent_price_cents")
  condominiumFeeCents     Int?            @map("condominium_fee_cents")
  iptuCents               Int?            @map("iptu_cents")
  commercialTermsJson     Json            @map("commercial_terms_json")
  featuresJson            Json            @map("features_json")
  amenityGroupsJson       Json            @map("amenity_groups_json")
  videosJson              Json            @map("videos_json")
  publicationSettingsJson Json            @map("publication_settings_json")
  descriptionTemplateKey  String?         @map("description_template_key") @db.VarChar(100)
  privateArea             Float?          @map("private_area")
  totalArea               Float?          @map("total_area")
  bedrooms                Int?
  bathrooms               Int?
  suites                  Int?
  parkingSpaces           Int?            @map("parking_spaces")
  publishedAt             DateTime?       @map("published_at")
  siteFeatured            Boolean         @default(false) @map("site_featured")
  importSource            String?         @map("import_source") @db.VarChar(80)
  importExternalId        String?         @map("import_external_id") @db.VarChar(180)
  importJobId             String?         @map("import_job_id") @db.Char(36)
  importedAt              DateTime?       @map("imported_at")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")
  company                 Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner                   PropertyOwner?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // B4 (Fase B): antes desta migração, responsibleUserId era uma coluna solta
  // sem FK nem relation Prisma (o "corretor responsável" existia só como um
  // scalar não validado). Agora é uma relation real para AppUser (nenhuma
  // entidade Broker nova — reaproveita AppUser/roles, conforme escopo da
  // Fase B). onDelete: SetNull para nunca bloquear a remoção de um usuário.
  responsibleUser         AppUser?        @relation("PropertyResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  media                   PropertyMedia[]
  siteLeads               SiteLead[]
  appointments            Appointment[]
  importJob               ImportJob?      @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  importRows              ImportRow[]

  @@unique([companyId, code])
  @@index([companyId, status, publishedAt])
  @@index([companyId, operation])
  @@index([companyId, city, neighborhood])
  @@index([companyId, importSource, importExternalId])
  @@index([companyId, importJobId])
  @@index([companyId, createdAt, id])
  @@index([companyId, propertyType])
  @@index([companyId, status, siteFeatured, publishedAt])
  @@map("properties")
}

model PropertyOwnerLink {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String   @map("company_id") @db.Char(36)
  propertyId  String   @map("property_id") @db.Char(36)
  ownerId     String   @map("owner_id") @db.Char(36)
  isMainOwner Boolean  @default(false) @map("is_main_owner")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([companyId, propertyId, ownerId])
  @@index([companyId, propertyId])
  @@map("property_owner_links")
}

model PropertyMedia {
  id            String    @id @default(uuid()) @db.Char(36)
  companyId     String    @map("company_id") @db.Char(36)
  propertyId    String    @map("property_id") @db.Char(36)
  mediaType     String    @default("photo") @map("media_type") @db.VarChar(40)
  url           String    @db.VarChar(1200)
  caption       String?   @db.VarChar(240)
  position      Int       @default(0)
  storageBucket String?   @map("storage_bucket") @db.VarChar(160)
  storagePath   String?   @map("storage_path") @db.VarChar(700)
  mimeType      String?   @map("mime_type") @db.VarChar(120)
  fileSize      Int?      @map("file_size")
  isCover       Boolean   @default(false) @map("is_cover")
  createdAt     DateTime  @default(now()) @map("created_at")
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([companyId, propertyId, position])
  @@map("property_media")
}

model StoredFile {
  id               String   @id @default(uuid()) @db.Char(36)
  companyId        String   @map("company_id") @db.Char(36)
  entityType       String   @map("entity_type") @db.VarChar(80)
  entityId         String   @map("entity_id") @db.Char(36)
  provider         String   @db.VarChar(60)
  publicId         String   @map("public_id") @db.VarChar(700)
  resourceType     String   @map("resource_type") @db.VarChar(40)
  secureUrl        String   @map("secure_url") @db.VarChar(1200)
  originalFilename String   @map("original_filename") @db.VarChar(240)
  mimeType         String   @map("mime_type") @db.VarChar(120)
  sizeBytes        Int?     @map("size_bytes")
  width            Int?
  height           Int?
  format           String?  @db.VarChar(40)
  createdAt        DateTime @default(now()) @map("created_at")
  uploadedBy       String?  @map("uploaded_by") @db.Char(36)
  isTestData       Boolean  @default(false) @map("is_test_data")
  testBatchId      String?  @map("test_batch_id") @db.VarChar(120)
  sourceUrl        String?  @map("source_url") @db.VarChar(1200)
  importJobId      String?  @map("import_job_id") @db.Char(36)
  importSource     String?  @map("import_source") @db.VarChar(80)
  metadataJson     Json?    @map("metadata_json")
  // A6 (Fase A): propósito real do documento — antes só existia como ideia
  // documentada, nunca persistido. Usado pelo controle mínimo de acesso em
  // services/storage/purposes.ts (STORED_FILE_PURPOSES).
  purpose          String?  @db.VarChar(40)

  @@unique([provider, publicId])
  @@index([companyId, entityType, entityId])
  @@index([companyId, isTestData, testBatchId])
  @@index([companyId, importJobId])
  @@index([companyId, purpose])
  @@map("stored_files")
}

// A4 (Fase A): ledger de idempotência para operações financeiras sensíveis a
// duplicação (ex.: gerar cobrança a partir de contrato). Um duplo clique ou
// retry de rede reenvia a mesma chave; a constraint única abaixo garante, no
// nível do banco, que apenas uma execução vence a corrida — a segunda lê o
// resultado já registrado em vez de duplicar o efeito colateral. Fica em
// Prisma/MySQL (arquitetura canônica) mesmo protegendo endpoints cujos dados
// de negócio ainda vivem no Supabase legado (Financeiro não foi migrado
// nesta fase) — a chave é só o "portão" de concorrência, não o dado em si.
model IdempotencyKey {
  id           String    @id @default(uuid()) @db.Char(36)
  companyId    String    @map("company_id") @db.Char(36)
  scope        String    @db.VarChar(80)
  idempotencyKey String  @map("idempotency_key") @db.VarChar(200)
  status       String    @default("in_progress") @db.VarChar(20)
  responseJson Json?     @map("response_json")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

