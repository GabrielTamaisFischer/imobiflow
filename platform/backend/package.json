{
  "name": "@imobiflow/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/generate-prisma-if-env.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:validate": "prisma validate --schema ../prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema ../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema ../prisma/schema.prisma",
    "prisma:seed": "tsx ../prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@prisma/adapter-mariadb": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.84.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.8.0",
    "helmet": "^8.0.0",
    "jszip": "^3.10.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.16.5",
    "prisma": "^6.19.3",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  }
}
