NODE_ENV=production
APP_URL=https://imobifloww-main.vercel.app
FRONTEND_URL=https://imobifloww-main.vercel.app
CORS_ORIGIN=https://imobifloww-main.vercel.app

# Backend e frontend rodam na mesma implantacao Vercel. VITE_IMOBIFLOW_API_URL e opcional.
# Sem ela, o frontend chama /api na mesma origem.

# MySQL online principal. Em Railway/Vercel use MYSQL_PUBLIC_URL, nunca MYSQL_URL interno.
# O script adiciona connection_limit=1, connect_timeout=15 e sslaccept quando ausentes.
DATABASE_URL=mysql://imobiflow_app:CHANGE_ME@mysql.seudominio.com:3306/imobiflow?connection_limit=1&connect_timeout=15&sslaccept=accept_invalid_certs
# Opcional para CLI/migrations quando houver usuario administrativo separado. Nao precisa ir para o frontend.
PRISMA_MIGRATE_DATABASE_URL=

# Autenticacao canonica MySQL/JWT. JWT_SECRET deve conter ao menos 32 caracteres aleatorios.
IMOBIFLOW_AUTH_PROVIDER=mysql
JWT_SECRET=CHANGE_ME
AUTH_EXPOSE_TEST_TOKENS=false
BILLING_PROVIDER=
BILLING_PAST_DUE_GRACE_DAYS=3
ALLOW_SYNTHETIC_BILLING_PROVISIONING=false

# Storage ativo desta etapa: Cloudinary. Segredos ficam somente no backend/Vercel.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=imobiflow
CLOUDINARY_UPLOAD_PRESET=
IMPORT_MEDIA_CONCURRENCY=3
IMPORT_METRICS_ENABLED=false

# Alternativa futura: Cloudflare R2. Nao e obrigatoria nesta fase.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
