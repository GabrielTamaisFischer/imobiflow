VITE_IMOBIFLOW_API_URL=http://localhost:3333
DATABASE_URL=mysql://imobiflow:imobiflow_local_password@127.0.0.1:3306/imobiflow
NODE_ENV=development
APP_URL=http://localhost:5173
IMOBIFLOW_AUTH_PROVIDER=mysql
# Gere um segredo aleatorio com pelo menos 32 caracteres. Nunca use prefixo VITE_ para este valor.
JWT_SECRET=
# Somente testes automatizados. Nunca habilite em staging ou producao.
AUTH_EXPOSE_TEST_TOKENS=false
BILLING_PROVIDER=
BILLING_PAST_DUE_GRACE_DAYS=3
ALLOW_SYNTHETIC_BILLING_PROVISIONING=false
SYNTHETIC_BILLING_ADMIN_SECRET=
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=imobiflow
CLOUDINARY_UPLOAD_PRESET=
IMPORT_MEDIA_CONCURRENCY=3
IMPORT_METRICS_ENABLED=false
# Optional future provider: Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
NOTIFICATION_AUTOMATION_SECRET=change-me
NOTIFICATION_PROVIDER_WEBHOOK_SECRET=change-me-too
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
IUGU_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=
PORTAL_INTEGRATIONS_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
