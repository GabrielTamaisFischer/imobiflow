# STAGING (Diretriz Mestre do MVP, Fase 1). Ambiente publico de testes na Vercel,
# separado de producao. NUNCA aponte estes valores para o banco/URL de producao,
# e NUNCA copie estes valores para a configuracao de producao na Vercel.
NODE_ENV=staging
# ^ Fase 1, Item 1: propositalmente "staging", nunca "production" — e o unico
#   jeito do fail-safe de isFreeRegistrationEnabled() permitir cadastro aberto
#   (ele bloqueia incondicionalmente quando NODE_ENV=="production", com
#   qualquer outro valor). "staging" (em vez de "development") evita ativar de
#   forma nao intencional caminhos pensados para localhost, como o bypass de
#   auth local em local-dev-access.ts (isLocalDevAuthEnabled, restrito a
#   NODE_ENV==="development"|"test") — e ja e um valor reconhecido no codigo
#   (ver import-metrics.ts, que trata "staging" como ambiente proprio).
APP_URL=https://CHANGE_ME-staging.vercel.app
FRONTEND_URL=https://CHANGE_ME-staging.vercel.app
CORS_ORIGIN=https://CHANGE_ME-staging.vercel.app

# Cadastro aberto multiempresa (Fase 1, Itens 1-4): ligado somente em staging.
REGISTRATION_ENABLED=true
BILLING_REQUIRED=false
VITE_IMOBIFLOW_REGISTRATION_ENABLED=true

# Backend e frontend rodam na mesma implantacao Vercel; VITE_IMOBIFLOW_API_URL e opcional.

# Banco de staging (Fase 1, Item 8): TiDB Cloud Serverless (Starter, free tier,
# protocolo MySQL, compativel com Prisma). Nunca trocar para Supabase/Postgres.
DATABASE_URL=mysql://CHANGE_ME.root:CHANGE_ME@gateway01.CHANGE_ME.shared.aws.tidbcloud.com:4000/imobiflow_staging?sslaccept=strict

# Autenticacao canonica MySQL/JWT — gerar um segredo de staging proprio, nunca
# reaproveitar o segredo de producao.
IMOBIFLOW_AUTH_PROVIDER=mysql
JWT_SECRET=CHANGE_ME
AUTH_EXPOSE_TEST_TOKENS=false
BILLING_PROVIDER=
BILLING_PAST_DUE_GRACE_DAYS=3
ALLOW_SYNTHETIC_BILLING_PROVISIONING=false

# Storage de staging (Fase 1, Item 9): Cloudinary (mesmo provider ja configurado
# para producao neste repositorio). Free plan "para sempre", SEM cartao de credito
# (confirmado na documentacao oficial), 25 creditos/mes compartilhados entre
# armazenamento/banda/transformacoes (1 credito = 1000 transformacoes OU 1GB de
# storage OU 1GB de banda) — suficiente para o teste manual da Fase 1.
#
# Cloudflare R2 foi avaliado e tem free tier tecnicamente maior (10GB storage,
# 1M Class A + 10M Class B ops/mes, sem custo de egress), mas a Cloudflare EXIGE
# cartao de credito cadastrado para ativar o R2 mesmo permanecendo dentro da
# faixa gratuita (confirmado na comunidade oficial da Cloudflare) — por isso,
# por regra do Item 9/16 (nunca contratar servico que peca cartao sem STOP e
# aviso ao usuario), R2 NAO e o padrao desta fase. Fica documentado como
# alternativa futura, a ativar só com autorizacao explicita do usuario.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_UPLOAD_FOLDER=imobiflow-staging
CLOUDINARY_UPLOAD_PRESET=
IMPORT_MEDIA_CONCURRENCY=3
IMPORT_METRICS_ENABLED=false

# Alternativa futura (requer cartao de credito na Cloudflare — NAO ativar sem
# autorizacao explicita do usuario, mesmo que o uso real fique em R$0):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
